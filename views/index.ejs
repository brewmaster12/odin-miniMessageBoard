<html>
    <head>
        <title>Homepage</title>
        <link rel="stylesheet" href="/styles.css">
    </head>
  <body>
    <ul>
        <% messages.forEach((message, index) => { %>
            <li>
                <%= message.user %><br>
                <%= message.text %><br>
                <%= message.added %><br>
                <a href="/details/<%= index %>"><button>Open</button></a>
            </li>
        <% }); %>
    </ul>
    <a href="/new"><button>New message</button></a>
  </body>
</html>
